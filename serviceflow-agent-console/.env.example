OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=serviceflow_knowledge
QDRANT_VECTOR_SIZE=384
QDRANT_ENABLED=true
QDRANT_TIMEOUT_SECONDS=3.0
AUTH_SECRET=replace-with-a-stable-random-secret-at-least-32-chars
AUTH_ISSUER=serviceflow-agent-demo
AUTH_AUDIENCE=serviceflow-admin
AUTH_TOKEN_TTL_SECONDS=3600
DEMO_AUTH_ENABLED=false
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
AGENT_USERNAME=service_agent
AGENT_PASSWORD_HASH=
REDIS_URL=
RATE_LIMIT_BACKEND=memory
CHAT_RATE_LIMIT_ENABLED=true
CHAT_RATE_LIMIT_REQUESTS=60
CHAT_RATE_LIMIT_WINDOW_SECONDS=60
CLARIFY_CONFIDENCE_THRESHOLD=0.45
INTENT_CONFLICT_HIGH_CONFIDENCE_THRESHOLD=0.7
INTENT_CONFLICT_CONFIDENCE_GAP=0.12
AGENT_NODE_RETRY_DELAY_SECONDS=0.05
LLM_RETRY_ATTEMPTS=2
LLM_RETRY_DELAY_SECONDS=0.2
